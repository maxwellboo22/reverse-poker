# Copy these into your host's environment settings. Never commit a real .env file.
NODE_ENV=production
CLIENT_ORIGIN=https://your-website.example.com
# Number of proxies in front of the server (Render: 1). Leave 0 if none.
TRUST_PROXY_HOPS=1
# Temporarily set to true to check that visitor addresses look right, then remove.
LOG_CLIENT_IPS=false