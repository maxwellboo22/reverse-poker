{
  "name": "reverse-poker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "play": "tsx packages/poker-engine/scripts/play.ts",
    "dev:server": "pnpm --filter @reverse-poker/server dev",
    "dev:web": "pnpm --filter @reverse-poker/web dev",
    "start:server": "pnpm --filter @reverse-poker/server start",
    "build": "pnpm --filter @reverse-poker/web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}